# Shared secret every inbound webhook must send as `x-automation-key`.
AUTOMATION_WEBHOOK_SECRET=change-me

# Separate secret appended to the owner's dashboard link (?key=...).
AUTOMATION_DASHBOARD_SECRET=change-me-too

# Twilio — buy the number inside the CLIENT's own Twilio subaccount so the
# number stays theirs. Without these, SMS sends are recorded, not delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email sending (optional — only needed by automations that email).
RESEND_API_KEY=

# Only the quote follow-up drafts with a model today.
OPENAI_API_KEY=

PORT=3010
STORE_PATH=./data/all.json

# Set to 1 when the host provides cron and you POST /cron/tick instead.
DISABLE_INTERNAL_TICK=

# Per-client credentials: name these in the client's `secretEnv` so each
# client runs on their own Twilio subaccount, e.g.
# ACME_TWILIO_SID=
# ACME_TWILIO_TOKEN=
