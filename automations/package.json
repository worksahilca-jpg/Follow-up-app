{
  "name": "automations",
  "version": "0.1.0",
  "private": true,
  "description": "One automation engine, configured and branded per business owner. Sold as a custom project per client.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && node dist/src/server/main.js",
    "simulate": "npm run build && node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
