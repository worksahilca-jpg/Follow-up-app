# Copy this file to .env and fill in real values as you complete each setup step.

# ---- Database (Supabase Postgres) ----
# Project Settings -> Database -> Connection string, "URI" tab.
# DATABASE_URL: the pooled connection (port 6543, "Transaction" mode, has ?pgbouncer=true) — used by the running app.
# Should be the least-privilege `followup_app` role, not `postgres` — see docs/least-privilege-db-role.md.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection (port 5432) — used only by `prisma migrate`.
# Stays on the `postgres` (owner) role — the app's own role has no DDL rights on purpose.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ---- Google Cloud OAuth client ----
# One OAuth client, shared by two separate things — each needs its own
# "Authorized redirect URI" registered on the same client in Google Cloud
# Console (Credentials -> your OAuth client -> Authorized redirect URIs):
#   1. Gmail data access (src/lib/integrations/gmail.ts):
#        http://localhost:3000/api/integrations/gmail/callback
#   2. Sign-in (NextAuth, src/lib/auth.ts) — path is fixed by NextAuth:
#        http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match Gmail's "Authorized redirect URI" above (#1).
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# ---- AI scoring & drafting (OpenAI) ----
OPENAI_API_KEY=""

# ---- Login (NextAuth) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# ---- Who can create an account ----
# Sign-up is CLOSED unless PUBLIC_SIGNUP is exactly "true". Anything else
# — unset, empty, "1", "yes", "TRUE" — keeps it closed. Leave it unset.
#
# This fails closed on purpose. It used to be the other way round: an
# empty ALLOWED_EMAILS meant "anyone may sign up", so the door stood open
# in production with nothing saying so, and a stranger who found the site
# through Google created a real business (2026-09-23).
PUBLIC_SIGNUP=""

# Comma-separated tester list. With sign-up closed, a NEW email gets in
# only by being here, by having an AccessRequest approved on /admin, or by
# holding a pending team invite. Emptying this no longer opens the door;
# it just means the only ways in are the other two.
#
# It gates sign-UP, not sign-in: an email that already belongs to a
# business keeps working whatever this says, so changing it can never lock
# out an existing account. Take access away with Settings -> Team instead.
ALLOWED_EMAILS="you@example.com"

# ---- Platform admin dashboard (src/app/admin, founder-only) ----
# Comma-separated allowlist for the cross-tenant /admin dashboard — total
# businesses, leads platform-wide, tier/revenue breakdown, etc. across
# EVERY business, not just the signed-in user's own. Completely separate
# from ALLOWED_EMAILS above (which only gates ordinary sign-in) and from
# any business's own TeamRole (a business's own ADMIN does NOT get this).
# Opposite default from ALLOWED_EMAILS: leave empty/unset and /admin 404s
# for absolutely everyone, including you — there is no built-in fallback
# admin. Set this in Vercel's Project Settings -> Environment Variables
# (not just locally) once you're ready to use the real deployed dashboard.
PLATFORM_ADMIN_EMAILS=""

# ---- Billing (Stripe) ----
# Stripe Dashboard -> Developers -> API keys. Use the "Secret key" — starts
# with sk_test_ in test mode, sk_live_ once you go live.
STRIPE_SECRET_KEY=""
# Stripe Dashboard -> Product catalog -> your $29/mo product -> the Price's
# ID (starts with price_), NOT the Product ID (prod_).
STRIPE_PRICE_ID=""
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing
# secret" (starts with whsec_). The endpoint URL is:
#   http://localhost:3000/api/billing/webhook   (use the Stripe CLI locally)
#   https://yourdomain.com/api/billing/webhook  (once deployed)
STRIPE_WEBHOOK_SECRET=""

# ---- Automation scheduler (Vercel Cron) ----
# Any long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Only needs to be set on the deployed environment (Vercel), not locally —
# nothing runs the cron route locally. Vercel sends this same value back as
# an Authorization header when it calls /api/cron/automation on schedule
# (see vercel.json); without it that route rejects every request.
CRON_SECRET=""

# --- Security ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts Gmail OAuth
# tokens, Twilio Auth Tokens and Instagram tokens at rest (src/lib/crypto.ts).
# Never rotate without re-encrypting: rows encrypted under the old key
# become unreadable.
TOKEN_ENCRYPTION_KEY=

# --- Gmail push (docs/gmail-push-setup.md) ---
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_SECRET=

# --- Live AI voice agent (voice-agent/README.md) ---
VOICE_AGENT_WS_URL=
VOICE_AGENT_CALLBACK_SECRET=

# --- Error monitoring & security alerts (docs/error-monitoring-setup.md) ---
# Without SENTRY_DSN/NEXT_PUBLIC_SENTRY_DSN set, this is a safe no-op —
# nothing is sent anywhere, nothing else breaks. Both usually hold the
# same DSN value (a DSN is meant to be public; it only grants "submit
# events," never read access).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps — also optional; the build
# just skips source-map upload (with a warning) without these.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Team Slack notifications (src/lib/slack.ts) ---
# One shared Incoming Webhook for the team's own Slack — a hot lead and a
# server error both post here. Safe no-op without it. NOT a per-business
# customer feature (see the scoping note at the top of slack.ts) — don't
# reuse this for anything customer-facing without revisiting that.
SLACK_WEBHOOK_URL=

# --- One-click Instagram / Facebook connect (docs/meta-oauth-setup.md) ---
# Two SEPARATE Meta app identities, both under the same "FollowUp" app in
# the developer console. Without these, Settings falls back to pasting a
# token by hand — nothing breaks, it's just not one-click.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# WhatsApp on the owner's own number (docs/meta-oauth-setup.md §3): the
# Embedded Signup configuration id from the Meta console, created with the
# "WhatsApp Business app onboarding" (Coexistence) option. Uses the
# FACEBOOK_APP_ID/SECRET pair above. Without it, Settings → WhatsApp shows
# only the paste-a-token fallback.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# --- Outlook / Microsoft 365 capture (docs/outlook-setup.md) ---
# One app registration in Azure AD / Entra ID, tenant type "Accounts in
# any organizational directory and personal Microsoft accounts" so both a
# work/school 365 mailbox and a plain outlook.com one can connect. Without
# these, Settings shows Outlook as not set up yet — nothing else breaks.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/integrations/outlook/callback"
