# Copy this file to .env and fill in real values as you complete each setup step.
# Nothing here is required to run the app in demo mode.

# ---- Step 2: Database (Supabase Postgres) ----
# Project Settings -> Database -> Connection string, "URI" tab.
# DATABASE_URL: the pooled connection (port 6543, "Transaction" mode, has ?pgbouncer=true) — used by the running app.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ---- Step 3: Gmail (Google Cloud OAuth) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ---- Step 4: AI scoring & drafting (OpenAI) ----
OPENAI_API_KEY=""

# ---- Step 5: Login (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
