// FollowUp — production data model.
//
// DATABASE_URL: pooled connection (e.g. Supabase's port-6543 pgbouncer URL) —
//   used by the running app.
// DIRECT_URL: direct connection (e.g. Supabase's port-5432 URL) — used only
//   by `prisma migrate` / `prisma db push`, which can't run through a pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  name                    String?
  createdAt               DateTime          @default(now())
  business                Business?         @relation(fields: [businessId], references: [id])
  businessId              String?
  role                    TeamRole          @default(ADMIN)
  assignedLeads           Lead[]            @relation("AssignedLeads")
  integrations            Integration[]
  notifications           Notification[]
  savedFilters            SavedFilter[]
  stoppedReactivationRuns ReactivationRun[] @relation("StoppedReactivationRuns")

  // Every Gmail sync/automation lookup resolves the connected account via
  // "the user(s) on this business" — without this, that's a table scan.
  @@index([businessId])
}

enum TeamRole {
  ADMIN
  SALES
}

model Business {
  id                    String            @id @default(cuid())
  name                  String
  industry              String?
  teamSize              Int?
  avgDealValue          Float?
  primaryChannels       String[]
  onboarded             Boolean           @default(false)
  createdAt             DateTime          @default(now())
  // IANA name, e.g. "America/New_York" — drives which wall-clock hours
  // count as "business hours" when generating booking slots (see
  // src/lib/booking.ts). Not yet exposed in Settings; defaults to a
  // reasonable US timezone until it is.
  timezone              String            @default("America/New_York")
  // "followup" (default): availability is just the fixed business-hours
  // grid minus FollowUp's own Booking rows, as it always was. "google":
  // ALSO excludes real busy blocks from the connected Google Calendar
  // (see getGoogleCalendarBusyTimes in src/lib/integrations/gmail.ts) —
  // so a lead can't book over a meeting the owner already has. Only
  // meaningful when Gmail is connected; getAvailableSlots() falls back to
  // "followup" behavior if it isn't, rather than erroring.
  bookingCalendarSource String            @default("followup")
  users                 User[]
  leads                 Lead[]
  automations           Automation[]
  reactivationRuns      ReactivationRun[]
  suppressions          Suppression[]
  outboundSends         OutboundSend[]
  bookings              Booking[]
  sequences             Sequence[]
  sourceRules           SourceRule[]
  invites               Invite[]
  feedback              ProductFeedback[]
  rateLimitHits         RateLimitHit[]
  savedFilters          SavedFilter[]
  filteredEmails        FilteredEmail[]
  crmConnection         CrmConnection?

  // Billing (Stripe) — Free/Plus/Pro tiers plus an optional Voice add-on
  // (research/market/2026-09-11-tier-pricing-recommendation.md). subscriptionStatus
  // mirrors the Stripe Subscription.status string verbatim (active,
  // trialing, past_due, canceled, unpaid, incomplete, ...); null means
  // never subscribed. See src/lib/billing.ts for the access check.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // "free" (default, no Stripe subscription needed) | "plus" | "pro" —
  // synced from the subscription's tier line item by the webhook
  // (syncSubscription in src/app/api/billing/webhook/route.ts), never set
  // directly by client code. A subscription whose tier price ID matches
  // neither the current Plus nor Pro price falls back to "plus" rather than
  // erroring — this is what grandfathers every pre-existing $29/mo
  // subscriber onto Plus permanently, with no backfill migration needed:
  // their subscriptionStatus is active/trialing and their stored price ID
  // (once populated) just won't be the new Pro price.
  tier                 String    @default("free")
  // Whether the Voice add-on (two subscription items — a flat fee plus a
  // metered overage — see src/lib/stripe.ts) is currently attached to this
  // business's subscription. Independent of tier: Plus and Pro are both
  // Voice-eligible at the same price (research doc §4).
  voiceAddonEnabled    Boolean   @default(false)

  // Generic inbound lead-capture webhook (Zapier/Make/Google Forms bridge/
  // raw script) — see src/app/api/webhooks/lead/route.ts. Generated lazily
  // in Settings, not on every business.
  webhookSecret String? @unique

  // Outbound lead-event webhook — the reverse direction of webhookSecret
  // above: a URL THIS business points at their own CRM/Zapier/Make step,
  // so FollowUp can push lead.created / lead.stage_changed events out
  // instead of only receiving them. See src/lib/outboundWebhook.ts and
  // src/app/api/webhooks/outbound/route.ts. Null until they set one.
  outboundWebhookUrl String?

  // Twilio SMS/voice capture — a separate secret from webhookSecret above
  // on purpose: regenerating the generic Zapier-facing URL shouldn't
  // silently break a phone number's webhook config in the Twilio console,
  // which is far more annoying to notice and fix. twilioAuthToken is THIS
  // business's own Twilio Auth Token (not FollowUp's), needed to validate
  // that inbound requests actually came from Twilio — see
  // src/lib/twilio.ts and src/app/api/twilio/**.
  twilioSecret        String? @unique
  twilioAuthToken     String?
  // Needed for OUTBOUND sending (src/lib/twilio.ts sendSms) — not secret
  // the way the Auth Token is (both are shown openly in the Twilio
  // Console), so these are safe to echo back on GET, unlike the token.
  twilioAccountSid    String?
  twilioPhoneNumber   String?
  // The Twilio WhatsApp-enabled sender number (e.g. "+14155238886") —
  // deliberately separate from twilioPhoneNumber above rather than reused,
  // since a business's plain-SMS number and its WhatsApp sender are
  // commonly two different Twilio numbers (see
  // research/integrations/2026-09-06-whatsapp-business-production-readiness.md).
  // Same Account SID/Auth Token pair as SMS/voice above — one Twilio
  // account, multiple senders. Inbound uses the same twilioSecret as
  // SMS/voice (see src/app/api/twilio/whatsapp/[secret]/route.ts) — no
  // new secret needed, just a new URL path.
  whatsappPhoneNumber String?

  // A single pre-approved WhatsApp template (Twilio Content API), used only
  // to reopen a WhatsApp conversation that's gone past Meta's 24-hour
  // free-form-reply window (Twilio error 63016 — see sendWhatsApp() in
  // src/lib/twilio.ts). whatsappTemplateSid is Twilio's Content SID for the
  // approved template (starts "HX..."); whatsappTemplateBody is a cached
  // copy of its approved text (containing a "{{1}}" placeholder for the
  // lead's first name) shown back in Settings for reference — Twilio has no
  // API to read a template's text back, so this is the only record of it
  // FollowUp has. Approval itself happens per-business, in that business's
  // own Twilio/Meta Business Manager — nothing FollowUp can do on their
  // behalf, same as A2P 10DLC above.
  whatsappTemplateSid  String?
  whatsappTemplateBody String?

  // Privacy: may this business's (de-identified) conversation data be used
  // to improve FollowUp's models? Opt-in, off by default, and even when on
  // nothing leaves the production DB without the de-identification step
  // (docs/security-roadmap.md, "Training on customer data").
  allowModelTraining Boolean @default(false)

  // Live AI voice agent (src/app/api/twilio/voice/[secret]/route.ts +
  // the separate always-on audio-bridge service — see
  // research/integrations/2026-09-06-voice-ai-and-multilingual-scoping.md).
  // Off by default and opt-in per business on purpose: unlike every other
  // channel here, this is the one place FollowUp puts words in a caller's
  // ear in real time, on the business's behalf, with a real per-minute
  // cost and its own unresolved TCPA/recording-consent nuance (see the
  // research doc's Part 1) — a business has to deliberately turn it on,
  // it never silently activates just because Twilio + billing are
  // connected the way voicemail capture already does.
  voiceAgentEnabled Boolean @default(false)

  // Instagram DM capture — instagramUserId is the Instagram-scoped ID of
  // the business's own connected account (resolved automatically from the
  // access token at save time via the Graph API, not typed in by hand);
  // instagramAccessToken is the long-lived token generated in the Meta
  // Developer Console (App ID 2713853435677364 for now — one shared
  // FollowUp Meta app, not one per business). Unlike Twilio's per-business
  // webhook URL, Instagram webhooks are configured once, app-wide, in the
  // Meta console — inbound events arrive at the single shared endpoint
  // src/app/api/instagram/webhook/route.ts and get routed to the right
  // business by matching instagramUserId against the event's recipient
  // ID. See src/lib/instagram.ts.
  // Nothing automated leaves this account without someone tapping send.
  // Founder's decision, 2026-09-19, on handing FollowUp to its first beta
  // testers: "I can't hand them the full automated thing, I want them to
  // keep an eye." ASSISTED — the per-lead default — already runs a risk
  // check, but it SENDS what it judges safe, so a tester still had
  // messages going out in their name unreviewed. This holds every one of
  // them in the approval queue instead, whatever the risk verdict and
  // whatever the lead's tier.
  //
  // The instant acknowledgement to a brand-new lead is deliberately NOT
  // covered: it is the one message whose whole value is that nobody had
  // to be awake for it, and holding it would leave a lead waiting for the
  // exact reason this product exists. Granted with the beta plan
  // (grantBetaPlan in src/lib/billing.ts); off for everyone else.
  holdAllForApproval   Boolean @default(false)

  instagramUserId      String? @unique
  instagramAccessToken String?
  // How far the conversation poller has read (src/lib/instagramPoll.ts).
  // Meta's push delivery cannot be relied on — on 2026-09-19 a correctly
  // connected, correctly subscribed account received no webhook for a real
  // DM while the same message was readable through the API — so FollowUp
  // also ASKS, every few minutes, exactly as it does for Gmail. Null means
  // never polled: the first tick reads a short window back, never the whole
  // history, so connecting an account can't acknowledge old conversations.
  instagramSyncedAt    DateTime?

  // Facebook Page — Messenger DMs and Lead Ads (src/lib/facebook.ts). Same
  // Meta app and same webhook URL as Instagram; events for object "page"
  // route to the business whose Page ID matches entry.id. The Page access
  // token is encrypted at rest (src/lib/db.ts ENCRYPTED_FIELDS).
  facebookPageId          String? @unique
  facebookPageName        String?
  facebookPageAccessToken String?

  // WhatsApp through Meta's Cloud API, on the owner's OWN number
  // (Coexistence — the number stays in the WhatsApp Business app on their
  // phone; founder's decision 2026-09-19, see PRODUCT_DIRECTION and
  // research/integrations/2026-09-19-whatsapp-coexistence.md). Same Meta
  // app as Instagram/Messenger; inbound events arrive at
  // src/app/api/whatsapp/webhook and route to the business whose
  // whatsappPhoneNumberId matches value.metadata.phone_number_id. The
  // access token is the business-integration token Embedded Signup hands
  // back, encrypted at rest (src/lib/db.ts ENCRYPTED_FIELDS). Distinct from
  // the Twilio WhatsApp fields above, which stay for a business already on
  // that path; src/lib/sending.ts prefers this connection when both exist.
  whatsappWabaId        String?
  whatsappPhoneNumberId String? @unique
  whatsappAccessToken   String?
  // "+1 416-555-0100" as Meta displays it — for Settings copy only.
  whatsappDisplayNumber String?
  // "coexistence" (connected from the WhatsApp Business app, the normal
  // path) or "cloud" (a number that lives only in the API). Copy differs:
  // only a coexistence number shows the owner's own phone replies here.
  whatsappConnectMode   String?
  // The approved utility template (WhatsApp Manager, this business's own
  // WABA) FollowUp may send past the 24-hour window — name + language code
  // as the API wants them, and the approved wording kept for reference,
  // same reason as whatsappTemplateBody above. No template: a follow-up
  // past 24 hours is refused in plain words, never sent by email (R-003).
  whatsappCloudTemplateName     String?
  whatsappCloudTemplateLanguage String?
  whatsappCloudTemplateBody     String?
}

enum PipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// The four verdicts classifyThreadOutcome() can reach about a thread that
// went quiet. Asymmetric on purpose: COLD is the narrow bucket — the only
// one a reactivation message may be drafted for — and anything the model
// can't place confidently lands in UNCLEAR, which a human sees and nothing
// sends to. OFF_PLATFORM is the case with no honest answer from the thread
// alone: numbers were swapped, or a call was booked, and whatever happened
// next happened where FollowUp cannot see it.
/**
 * One press of "Send all" on the reactivation batch.
 * It exists as a ROW, not as a variable, for one reason: STOP has to work.
 * The owner presses Stop in one serverless invocation while the sending
 * loop is running in a different one — there is no shared memory between
 * them, and no way to signal the loop except through something both can
 * see. So the loop re-reads this row's status before every single send,
 * and Stop is a one-field UPDATE. That read is the entire difference
 * between a Stop button that works and one that just hides itself.
 */
model ReactivationRun {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String

  status ReactivationRunStatus @default(RUNNING)

  // What the owner was told they were approving, captured at the moment
  // they approved it. Kept even as the world moves on, so "you said yes to
  // 43" stays checkable against what actually went out.
  totalPlanned Int
  sent         Int @default(0)
  failed       Int @default(0)
  // Reached but deliberately not sent — already messaged by another run,
  // opted out since, or replied since the batch was built.
  skipped      Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Who pressed Stop. Null on a run that finished on its own.
  stoppedBy   User?   @relation("StoppedReactivationRuns", fields: [stoppedById], references: [id])
  stoppedById String?

  @@index([businessId, status])
  @@index([businessId, startedAt])
}

enum ReactivationRunStatus {
  RUNNING
  // The owner pressed Stop. Distinct from COMPLETED on purpose: "you
  // stopped this after 12 of 43" is a different thing to tell someone
  // than "43 sent", and conflating them loses the only record that the
  // remaining 31 were a choice rather than a failure.
  STOPPED
  COMPLETED
  // The run itself broke, as opposed to individual sends failing.
  FAILED
}

/**
 * An address that has asked a business to stop sending it automated mail.
 * Keyed on the ADDRESS, not on a Lead row, because that is what the person
 * actually opted out. A lead can be deleted and re-imported from the same
 * mailbox tomorrow, arrive again through another channel, or exist twice
 * before a merge — a column on Lead would forget in every one of those
 * cases and start mailing them again with no way for them to tell anyone.
 * Deliberately separate from Lead.optedOutAt, which is the SMS/WhatsApp
 * STOP mechanism (TCPA). Different law, different channel, different
 * lifecycle: an email suppression can only be cleared by the business
 * owner in Settings, while a DM suppression — the same STOP keyword,
 * arriving over Instagram or Messenger — is cleared by the lead sending
 * START, exactly as it would be over SMS.
 */
model Suppression {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  // "email" | "instagram" | "messenger". Left as a string rather than an
  // enum so a new channel needs no migration to the type — which is
  // exactly what the two DM channels then needed: none.
  channel    String
  /// Normalised: trimmed and lowercased. See normaliseAddress().
  /// For a DM this is the platform-scoped user id (IGSID / PSID) — the
  /// only identifier those platforms give us, and the same one
  /// src/lib/sending.ts addresses the message to.
  address    String
  /// unsubscribe_link | one_click | manual | complaint | keyword
  reason     String
  createdAt  DateTime @default(now())

  // The send path's only question is "is this exact address suppressed",
  // asked before every automated email — so the lookup is the unique index.
  @@unique([businessId, channel, address])
  @@index([businessId, channel])
}

enum QuietOutcome {
  COLD
  // Dropped by US, not by them: the lead's own message is the last thing in
  // the thread and nobody here ever answered it. Split out of COLD because
  // the right message is a different message — "just checking in, still
  // interested?" to someone whose question you ignored for two months is
  // not a follow-up, it's an insult. Decided in code from the last
  // message's direction, never by the model; the model only ever says
  // whether the thread was dropped at all.
  COLD_UNANSWERED
  CLOSED
  OFF_PLATFORM
  UNCLEAR
}

enum Priority {
  HIGH
  MEDIUM
  LOW
  NONE
}

// Per-lead trust tier for automated follow-ups (see src/lib/automation.ts).
// ASSISTED is the default (CEO decision, 2026-09-06): the product's job is
// that the follow-up gets DONE without the owner remembering — a default
// of OFF just moved the thing they forget from "write the email" to
// "click approve." The guarantee that makes the default safe is explicit
// and user-visible: nothing about pricing, terms, or a tense conversation
// goes out without approval, and everything stops the instant the lead
// replies. Owners dial any lead down to OFF or up to AUTONOMOUS.
//   OFF        — never sent automatically; every draft needs manual approval.
//   ASSISTED   — automated sends allowed, but each draft still passes
//                assessSendRisk() first; anything not low-risk is held for
//                manual approval instead of sent.
//   AUTONOMOUS — the risk check is skipped entirely; this lead's cadence is
//                fully AI-owned. Opt-in per lead, never a default.
enum AutomationTier {
  OFF
  ASSISTED
  AUTONOMOUS
}

model Lead {
  id               String         @id @default(cuid())
  business         Business       @relation(fields: [businessId], references: [id])
  businessId       String
  name             String
  company          String?
  email            String?
  phone            String?
  source           String?
  stage            PipelineStage  @default(NEW)
  dealValue        Float          @default(0)
  score            Int            @default(0)
  scoreReason      String?
  scoreFactors     Json? // ScoreFactor[] — [{ label, weight }], from AI scoring
  suggestedMessage String? // AI-drafted follow-up, edited/approved before sending
  suggestedSubject String? // AI-drafted subject line for the same email, same edited/approved-before-sending path
  // The sentAt of the newest message the cached draft above was written
  // against. Null means "unknown" (any draft written before this column
  // existed), which is treated as stale so nothing silently reuses a draft
  // whose provenance can't be established.
  //
  // This is what makes a held lead free. A lead parked in the approval
  // queue changes nothing about itself — no outbound is sent, so
  // lastContacted never moves — and it therefore re-enters the automation
  // window every 20 hours (lastAutomationCheckedAt, below) forever. Before
  // this column, each of those passes paid for a fresh draft, a fresh
  // translation and a fresh risk check on a byte-identical conversation:
  // $0.026/lead/month with no end, the only cost in the product that grew
  // with time rather than with leads, and the mandatory hold on cold leads
  // guarantees a standing population of them
  // (research/product/2026-09-15-ai-cost-per-lead.md §5).
  suggestedDraftedFor DateTime?
  // The reply buttons drafted alongside suggestedMessage when that draft
  // is DM-shaped (the lead last wrote on Instagram or Messenger) — shape
  // { question, buttons: [{ title, exit }] }, see StoredQuickReplies in
  // src/lib/quickReplies.ts. Null means the draft is an email (or predates
  // this column), which is how the automation pass knows an old
  // email-framed draft must be rebuilt before it goes out as a DM. An
  // empty `buttons` list is a DM draft that passed without chips.
  suggestedQuickReplies Json?
  // Why FollowUp did NOT read this lead or write anything for it — set
  // whenever checkAiEligibility (@/lib/billing) refuses, cleared the
  // moment a score/draft actually lands (src/lib/scoring.ts).
  //
  // The whole sentence, written for the owner, not the fragment the run
  // summaries use. It is a cache of a decision that is recomputed every
  // pass, never a source of truth: nothing reads it to decide anything,
  // only to say something.
  //
  // 2026-09-19, the case that forced it. A real Instagram DM arrived,
  // the business was on Free (which does not cover Instagram), and
  // checkAiEligibility correctly refused. Its reason was thrown away by
  // every one of the three callers. The owner saw a lead with no score,
  // no reason and no draft, sitting next to a badge that said
  // "Following up soon" — a promise nothing was going to keep. The
  // product knew the answer and showed a blank, which reads as broken
  // and is worse than the refusal itself
  // (design-brain/brand/brand-principles.md 6: show the reasoning, not
  // just the verdict).
  aiPausedReason   String?
  priority         Priority       @default(NONE)
  lastContacted    DateTime?
  nextFollowUp     DateTime?
  notes            String?
  automationTier   AutomationTier @default(ASSISTED)
  assignedTo       User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // checkRapidEngagement()'s dedup marker (src/lib/engagement.ts) — set via
  // a conditional updateMany (WHERE null OR older than the window) instead
  // of a findFirst-then-create Notification check, so the whole
  // check-and-mark happens as one atomic UPDATE statement at the DB level:
  // two concurrent inbound messages can't both pass the check the way a
  // separate read-then-write could.
  lastRapidEngagementNotifiedAt DateTime?

  // Same atomic-conditional-update pattern as
  // lastRapidEngagementNotifiedAt above, backing the Twilio voice
  // webhook's missed-call text-back (src/app/api/twilio/voice/[secret]/route.ts).
  // Without it, a caller who calls back two or three times in a row before
  // the first attempt connects (a very normal "missed call, try again"
  // pattern) would get a near-identical text after every single one —
  // this caps it to one per cooldown window per lead.
  lastMissedCallTextAt DateTime?

  // When the instant acknowledgement went out (src/lib/acknowledge.ts) —
  // the short "we got your message" a brand-new lead gets within a minute
  // of their first inbound, on the channel they used. Same atomic
  // conditional-update claim as the two markers above: set exactly once
  // per lead, never twice, no matter how many channels or webhooks fire.
  acknowledgedAt DateTime?

  // The DM grace period (src/lib/acknowledge.ts, DM_ACK_GRACE_PERIOD_MS).
  //
  // On Instagram, Messenger and WhatsApp the acknowledgement is no longer
  // sent from the webhook: it is parked here and sent ~2 minutes later by
  // /api/cron/instant-ack, so an owner who is holding their phone and
  // answers the DM themselves wins and FollowUp stays quiet. Two slightly
  // different replies from the same business, seconds apart, is the thing
  // this prevents.
  //
  // `ackDueAt` is both the due-at and the lock: a worker claims a row by
  // pushing it forward one lease (ACK_CLAIM_LEASE_MS) in the same atomic
  // updateMany that matches `ackDueAt <= now`, so two overlapping cron
  // ticks can never both work the same lead. It is cleared when the ack is
  // sent or is refused for good; an invocation killed mid-flight leaves it
  // in the future and the next tick picks it up, which is the answer to
  // "what if the deferred ack never runs". Lead.acknowledgedAt above is
  // still the once-ever guarantee — this queue never weakens it.
  //
  // The other three are the envelope, stored rather than re-derived at
  // send time: `ackInboundText` is the lead's OWN words (never the
  // synthesized "[Sent 1 image…]" placeholder the DM paths write for an
  // attachment-only message, which must never be fed to the model), and
  // `ackInboundAt` is when THEY wrote, so the staleness check still
  // measures from their message rather than from whenever the cron ran.
  // All four are cleared together; a second DM inside the window refreshes
  // the text without pushing the due time back.
  ackDueAt       DateTime?
  ackChannel     String? // instagram | messenger | whatsapp
  ackInboundText String?
  ackInboundAt   DateTime?

  // When the silence automation (src/lib/automation.ts) last considered
  // this lead. The check runs hourly so a lead going quiet is caught the
  // same day, but a lead it HELD for approval (risk not low) would
  // otherwise be re-assessed 24 times a day for the same verdict — this
  // skips any lead looked at within the last ~20 hours.
  lastAutomationCheckedAt DateTime?

  // Workflow enrollment (see src/lib/sequences.ts). sequenceStepIndex is
  // the index of the step that runs NEXT (0 before anything has run);
  // sequenceStepDueAt is when that step is eligible to run — recomputed
  // after each step executes, so the cron query is a plain "is it due"
  // check instead of walking delays at read time. Both null means "not
  // enrolled" — unrelated to automationTier's silence-based cadence above,
  // and the two are mutually exclusive per lead (see sequences.ts) so they
  // never both try to send on the same lead.
  sequence            Sequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  sequenceId          String?
  sequenceStepIndex   Int       @default(0)
  sequenceStepDueAt   DateTime?
  // When the CURRENT step was scheduled — enrollment for step 0, the
  // previous step's run for every later one. Stop-on-reply compares the
  // lead's newest inbound against this: only a message that arrived AFTER
  // the workflow last acted counts as "replied mid-sequence". Without it,
  // enrolling any lead whose newest message was already inbound — every
  // DM/SMS/email lead the moment they are captured — self-cancelled at
  // step 0 with a "replied mid-sequence" note, before a single step ran
  // (audit 2026-09-16, F4). Null on rows from before the column: those keep
  // the old rule, which errs towards stopping.
  sequenceStepScheduledAt DateTime?
  // Set once, in runSequencesForBusiness()'s "finished the last step"
  // branch — the only sequence exit path that gets a persisted timestamp.
  // Deliberately NOT set on early unenroll (manual, sequence deleted, or
  // the stop-on-reply pause) — those all just clear sequenceId/
  // sequenceStepIndex/sequenceStepDueAt with no distinguishing signal, so
  // "why did this lead leave its sequence" isn't otherwise knowable from
  // stored data. Kept as a running "last completed at" marker (not reset
  // on re-enrollment) so getAnalytics()'s sequence-health metric has a
  // real, honest "completed in the last 30 days" count instead of one
  // that conflates completion with every other kind of exit.
  sequenceCompletedAt DateTime?

  // TCPA/CTIA consent: set the moment a lead texts STOP (or an equivalent
  // opt-out keyword) on SMS or WhatsApp — see isOptOutMessage() in
  // src/lib/optOutKeywords.ts and the inbound webhooks that call it. Every
  // send path funnels through sendFollowUpToLead() (src/lib/sending.ts),
  // which refuses to text/WhatsApp an opted-out lead regardless of which
  // caller asked (manual, automated, sequence) — this is a hard stop, not
  // a risk signal to weigh. A later START/UNSTOP clears it. Deliberately
  // does NOT block email/Instagram/Messenger sends — STOP is the SMS-
  // specific legal mechanism (TCPA), not a general "never contact again."
  // Those channels have their own opt-out record in Suppression below
  // (email: an unsubscribe click; Instagram/Messenger: the same STOP
  // keyword, keyed on the platform user id so it outlives the Lead row).
  optedOutAt DateTime?

  // What classifyThreadOutcome() judged happened to this lead's
  // conversation before it went quiet (src/lib/integrations/openai.ts).
  // Deliberately NOT the same field as `stage`: stage is what the owner
  // says is true and is theirs to set, this is what an AI inferred from
  // the thread text and may well be wrong. Writing an inferred WON or
  // LOST straight into stage would silently rewrite the owner's own
  // pipeline on the strength of a guess — the two are kept apart so a
  // wrong verdict costs a tap, not a customer record.
  //
  // Null means "never judged", which is every lead that isn't a quiet
  // imported one: the classifier runs only on threads already past the
  // silence threshold, since a live conversation needs no verdict and
  // judging every imported thread would double a sync's OpenAI cost.
  // Only COLD leads are eligible for a reactivation draft.
  quietOutcome       QuietOutcome?
  quietOutcomeReason String?
  quietOutcomeAt     DateTime?

  // Claimed the instant a reactivation message is about to go out, and
  // never cleared. This is the hard guarantee that ONE lead gets AT MOST
  // ONE reactivation message, ever — across repeated batches, a stopped
  // run that's restarted, an owner double-tapping "Send all", and two
  // serverless invocations overlapping. Claimed with the same atomic
  // conditional updateMany the rest of the codebase uses (see
  // lastRapidEngagementNotifiedAt): whoever's UPDATE matches the
  // `reactivationSentAt: null` row wins, the loser's matches nothing and
  // skips. A per-run guard alone could not promise this — runs are rows,
  // and two of them can exist.
  //
  // Deliberately NOT cleared on failure: a send that threw after the
  // provider accepted it is indistinguishable from one that didn't, and
  // "we might have already emailed them" has to resolve to "don't email
  // them again."
  reactivationSentAt DateTime?

  // When a human overruled the AI prospect classifier for this lead —
  // Settings → filtered emails → "this was a lead", which re-imports the
  // thread through importGmailThread/importOutlookConversation with
  // skipClassification and drops the FilteredEmail row.
  //
  // That override used to leave NO trace on the lead. The restored lead
  // comes back tagged source "Gmail" like any other, and the FilteredEmail
  // row that held the classifier's verdict is deleted, so the retroactive
  // clean-up pass (POST /api/leads/cleanup) would re-ask the same model
  // about the same thread and could delete the very lead the owner had
  // just rescued — silently reversing them, with the same AI judgment they
  // had already rejected once.
  //
  // A column rather than a lookup in AuditEvent because this has to be
  // enforceable in a WHERE clause: the clean-up query has to be able to
  // exclude rescued leads before it spends anything on them, and AuditEvent
  // holds targetId as a loose String with no relation to walk. It is also a
  // property of the lead, not of a session. Null means "never overruled",
  // which is every lead that came straight from sync.
  //
  // Read as a hard stop, never as a signal to weigh: a lead a human rescued
  // is never auto-deleted again, by this pass or any future one.
  classificationOverriddenAt DateTime?

  conversations Conversation[]
  deals         Deal[]
  followUps     FollowUp[]
  tasks         Task[]
  insights      AIInsight[]
  bookings      Booking[]
  outboundSends OutboundSend[]

  // Which outside CRM this lead came from, and its id there — set by
  // src/lib/crmSync.ts, used both to avoid re-importing the same contact
  // and to push a note back after FollowUp sends on their behalf (see
  // sendFollowUpToLead in src/lib/sending.ts).
  crmProvider String?
  crmId       String?

  @@unique([businessId, email])
  // Postgres allows multiple NULLs in a unique index, so leads with no
  // phone (manual entry, CSV import, website-form-by-email-only) are
  // unaffected — this only blocks two rows sharing one real
  // (businessId, phone). Backs findOrCreateLeadByPhone()'s and
  // findOrCreateLeadByInstagram()'s P2002 fallback against the race two
  // concurrent inbound messages for the same new contact create.
  @@unique([businessId, phone])
  @@unique([businessId, crmProvider, crmId])
  // getLeads() and the cron/automation eligibility query both filter on
  // businessId plus one of these — without a composite index each is a
  // full scan of the business's leads once that list gets big.
  @@index([businessId, stage])
  // The reactivation batch's "which of this business's quiet leads are cold"
  // scan — see quietOutcome above.
  @@index([businessId, quietOutcome])
  @@index([businessId, score])
  @@index([businessId, source])
  // The workflow cron's "which enrolled leads are due right now" scan.
  @@index([businessId, sequenceStepDueAt])
  // getAnalytics()'s sequence-health "completed in the last 30 days" scan.
  @@index([businessId, sequenceCompletedAt])
  // The instant-ack worker's "which deferred acknowledgements are due right
  // now" scan. Deliberately NOT prefixed with businessId, unlike the five
  // above: that query runs once a minute across every tenant at once (same
  // shape as OutboundSend's status/nextAttemptAt index), and a
  // business-prefixed index cannot serve it.
  @@index([ackDueAt])
}

model Conversation {
  id            String    @id @default(cuid())
  lead          Lead      @relation(fields: [leadId], references: [id])
  leadId        String
  channel       String // email | call | text | whatsapp | instagram
  externalId    String?   @unique // Gmail thread id / Outlook conversationId, for idempotent sync
  // Which mailbox a channel:"email" conversation actually lives in — null
  // (a row from before this field existed, or a manual-entry lead with no
  // captured thread yet) means Gmail, the original and long-standing
  // default. Read by detectEmailProvider() in src/lib/sending.ts so a
  // reply goes out from the same mailbox the lead's thread is actually
  // in, not always Gmail once a business has both connected.
  emailProvider String?
  messages      Message[]
  createdAt     DateTime  @default(now())

  @@index([leadId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      String // inbound | outbound
  body           String
  opened         Boolean      @default(false)
  externalId     String?      @unique // Gmail message id, for idempotent sync
  sentAt         DateTime     @default(now())

  // What FollowUp sent this under — the same value as the FollowUp row
  // written beside it (instant_ack | unanswered | silence | sequence |
  // manual). Null for every inbound message and for any outbound FollowUp
  // did not send itself: an owner's reply synced from Gmail/Outlook, a Meta
  // echo (see `source` below). Exists so the one outbound that is NOT a
  // reply — the instant acknowledgement, boilerplate sent to everyone — can
  // be told apart from every outbound that is, without a join. Before this,
  // findUnansweredLeads() saw the ack as "someone answered", so the 3-hour
  // first-reply rule and the 20-hour Meta ceiling never fired for a lead
  // who wrote once and got the ack (audit 2026-09-16, F2). Backfilled by
  // matching FollowUp.message to Message.body per lead.
  trigger        String?

  // Set on an INBOUND Instagram/Messenger message that was a tap on one of
  // FollowUp's reply buttons rather than typed: the chip's payload, as
  // src/lib/quickReplies.ts encoded it (which message carried the chip,
  // which question it answered, and whether it was the honest-no exit).
  // The body holds the chip's title, exactly as Meta posts it to the
  // conversation, so the thread reads naturally; this column is what lets
  // the engine tell "tapped 'Not now'" from "typed 'Not now'" — the first
  // stops every further automatic message, the second is just words.
  quickReplyPayload String?

  // Twilio delivery status for an outbound text/WhatsApp send — set from
  // Twilio's own MessageStatus callback (queued/sent/delivered/undelivered/
  // failed), not from the synchronous send response, which only confirms
  // Twilio *accepted* the message, not that a carrier actually delivered it.
  // Null for every message that isn't an SMS/WhatsApp send with a
  // StatusCallback configured (email, Instagram, inbound messages, sends
  // made before this shipped) — absence means "not tracked," not "failed."
  // See src/app/api/twilio/status/[secret]/route.ts.
  deliveryStatus       String?
  deliveryErrorCode    String?
  deliveryErrorMessage String?
  deliveryUpdatedAt    DateTime?

  // Set only for an outbound message FollowUp captured but didn't send
  // itself — e.g. "instagram_direct" / "messenger_direct" for a reply
  // Meta's own Business AI (or a teammate using the native Instagram/
  // Messenger app) sent on the business's behalf, seen only as a webhook
  // "echo" (see src/app/api/instagram/webhook/route.ts). Null means
  // FollowUp sent it (sendFollowUpToLead, src/lib/sending.ts) — the
  // common case, left untouched everywhere else rather than backfilled.
  // The point: task #68's "ingest what Meta handled" needs the real
  // conversation history to include these, and needs the existing
  // human-neglect trigger (src/lib/automation.ts) to see them as a real
  // outbound reply, so a lead Meta's AI already answered isn't
  // double-messaged, and a lead it handled and then dropped still gets
  // rescued — for free, on the same machinery, with no new "was this the
  // AI" detection to get wrong.
  source String?

  @@index([conversationId])
}

model Deal {
  id        String        @id @default(cuid())
  lead      Lead          @relation(fields: [leadId], references: [id])
  leadId    String
  value     Float
  stage     PipelineStage
  wonAt     DateTime?
  lostAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([leadId])
}

model FollowUp {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String
  channel     String // email | call | text | whatsapp | instagram
  message     String?
  status      String    @default("pending") // pending | sent | dismissed | snoozed
  automated   Boolean   @default(false)
  scheduledAt DateTime?
  sentAt      DateTime?
  // Outcome tracking, first-class from day one per the product's own
  // "core data moat" framing (see src/lib/outcomes.ts): set once the lead
  // replies to this specific follow-up. Null means "sent, no reply yet" —
  // distinct from never having sent one at all (sentAt null).
  repliedAt   DateTime?
  // What produced this send — instant_ack | unanswered | silence | sequence
  // | manual. The attribution behind "what FollowUp saved you this week"
  // (src/lib/rescued.ts): a reply to an automated trigger is a rescued
  // conversation; a reply to a manual send is the owner's own work.
  trigger     String?
  // Did a person change the AI draft before this went out? Compared at
  // send time against Lead.suggestedMessage (whitespace-insensitive).
  // Null when there was no draft to compare against (a send typed from
  // scratch, an instant acknowledgement). The one quality number every
  // comparable AI-drafting product watches (accuracy research 2026-09-13,
  // finding 9); surfaced on /analytics as "Drafts sent as written".
  draftEdited Boolean?
  // The AI draft exactly as it stood when this went out, kept ONLY for a
  // business that opted in to improving FollowUp (Business.allowModelTraining)
  // — null otherwise, whatever draftEdited says. Beside `message` (what was
  // actually sent) it is the diff the founder reads each week to fix the
  // drafting instructions: the one thing ten beta testers can teach that
  // no metric can. Read through the de-identification boundary
  // (src/lib/deidentify.ts) before it is shown anywhere.
  draftText   String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([trigger, sentAt])
  // getWeeklyReport's "sent in the last 7 days, for these leads" query.
  @@index([status, sentAt])
  // detectReplies()'s "sent, still waiting on a reply, for this business's
  // leads" query.
  @@index([status, repliedAt])
}

/**
 * One automated outbound message that a provider refused for a reason that
 * resolves on its own — a Twilio 500, a Gmail rate limit, a socket that hung
 * up — held so it can be tried again instead of being lost.
 *
 * Why this is not a FollowUp row with status "queued"
 * --------------------------------------------------
 * FollowUp is the record of what WAS sent. It is read by the weekly report,
 * the rescued-leads attribution, reply-outcome detection and the daily send
 * cap (sendCaps.ts counts FollowUp rows), and every one of those queries
 * means "a real message went to a real person". Putting unsent attempts in
 * that table would silently change the meaning of all of them — a queued row
 * would count against the fuse before anything left, and "sent" would stop
 * being a fact about the world. It also carries none of the envelope a retry
 * needs (subject, thread id, in-reply-to, audit meta) and none of the queue
 * mechanics (attempt count, backoff, lock), so it would have to grow them
 * anyway, on the one table the reporting layer depends on.
 *
 * The cost of the separate table is that two rows now describe one send: this
 * one until it lands, a FollowUp once it does. That is the trade accepted —
 * the queue stays entirely out of the way of every existing query, and
 * "delivered" remains a single unambiguous fact rather than a status filter
 * every caller has to remember.
 *
 * Never sent twice: a worker takes a row with the same atomic conditional
 * updateMany the rest of this codebase claims with (see
 * Lead.reactivationSentAt, Lead.lastAutomationCheckedAt) — WHERE status =
 * 'queued' AND nextAttemptAt <= now, SET status = 'sending'. Two overlapping
 * invocations cannot both match.
 */
model OutboundSend {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  lead       Lead     @relation(fields: [leadId], references: [id])
  leadId     String

  // The full envelope of the send, exactly as sendFollowUpToLead() was
  // asked for it. Stored rather than re-derived because a retry must send
  // the message the risk gate already approved — re-drafting would put a
  // message nobody reviewed on the wire, and would pay OpenAI again to do
  // it.
  channel        String // email | text | whatsapp | instagram | messenger
  body           String
  subject        String?
  emailThreadId  String?
  emailInReplyTo String?
  trigger        String? // instant_ack | unanswered | silence | sequence | dead_lead_reactivation
  auditMeta      Json? // sendFollowUpToLead's extraAuditMeta, replayed on the successful attempt

  // queued   — waiting for nextAttemptAt
  // sending  — claimed by an invocation right now
  // sent     — a later attempt got through; a FollowUp row exists for it
  // failed   — terminal: attempts exhausted, a permanent provider rejection,
  //            or an invocation killed mid-attempt (see lastError)
  // canceled — terminal: a guard refused it at retry time (the lead opted
  //            out, the address was suppressed, the daily fuse tripped).
  //            Deliberately distinct from `failed`: nothing went wrong, the
  //            product correctly declined to send.
  // A String rather than an enum, like FollowUp.status, so a sixth outcome
  // needs no migration to the type.
  status String @default("queued")

  // Includes the original inline attempt inside sendFollowUpToLead, so a row
  // is created at 1. Bounded by maxAttempts; growing delays between them.
  attempts      Int      @default(1)
  maxAttempts   Int      @default(5)
  nextAttemptAt DateTime

  // When the current attempt claimed this row. A row left `sending` with a
  // stale lock is an invocation that was killed mid-attempt: its outcome is
  // unknown, so it is retired to `failed` rather than retried. "We might
  // have already sent it" resolves to "don't send it again" here for the
  // same reason it does on Lead.reactivationSentAt.
  lockedAt DateTime?

  // Owner-facing on the terminal states — this is what someone reads when
  // they ask why a message never went out.
  lastError  String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The worker's "what is due right now" scan, across all businesses.
  @@index([status, nextAttemptAt])
  // "Is there already a send in flight for this lead" — the guard that stops
  // a caller (a workflow step, the hourly rule) from starting a second send
  // while a retry for the same lead is still pending.
  @@index([leadId, status])
  @@index([businessId, status])
}

model Task {
  id        String    @id @default(cuid())
  lead      Lead      @relation(fields: [leadId], references: [id])
  leadId    String
  type      String // call | email | text | meeting | custom
  title     String
  dueAt     DateTime?
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([leadId])
}

// A call a lead booked themselves through their public booking link (see
// src/lib/booking.ts and /book/[leadId]) — distinct from Task, which is an
// internal to-do the business creates for itself.
model Booking {
  id              String   @id @default(cuid())
  business        Business @relation(fields: [businessId], references: [id])
  businessId      String
  lead            Lead     @relation(fields: [leadId], references: [id])
  leadId          String
  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  status          String   @default("confirmed") // confirmed | canceled
  createdAt       DateTime @default(now())

  // The real double-booking guard: two people confirming the same slot in
  // the same instant race a findFirst-then-create check in application
  // code, but not this constraint — the DB rejects the second insert
  // outright. The lead's own detail page lists its bookings by leadId.
  @@unique([businessId, scheduledAt])
  @@index([leadId])
}

// A multi-step automated follow-up workflow, built visually in
// src/app/(app)/workflows — a business defines an ordered list of
// SequenceSteps once, then enrolls individual leads into it. Distinct
// from the single silence-triggered rule on Automation/automationTier:
// a lead is enrolled in at most one Sequence at a time, and enrollment
// takes over its automated cadence entirely while active (see
// src/lib/sequences.ts for how the two stay mutually exclusive).
model Sequence {
  id          String         @id @default(cuid())
  business    Business       @relation(fields: [businessId], references: [id])
  businessId  String
  name        String
  active      Boolean        @default(true)
  steps       SequenceStep[]
  leads       Lead[]
  sourceRules SourceRule[]
  createdAt   DateTime       @default(now())

  @@index([businessId])
}

enum SequenceAction {
  EMAIL // AI-drafted (messageHint steers it) follow-up email, sent automatically
  CHANGE_STAGE // moves the lead to stageTo with no message sent
}

model SequenceStep {
  id          String         @id @default(cuid())
  sequence    Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId  String
  // 0-based position in the sequence — also how long a step waits: delayDays
  // is measured from when the PREVIOUS step ran (or from enrollment, for
  // step 0), not from a fixed start date.
  order       Int
  delayDays   Int
  // Hours between the previous step and this one — the unit the scheduler
  // actually runs on since 2026-09-16. Nullable only so the column could be
  // added without a rewrite: sequences.ts treats null as delayDays * 24, and
  // every write since then sets both. Why hours at all: Meta shuts the
  // Instagram / Messenger door 24 hours after the lead's last message, so a
  // plan that can only count in whole days cannot place a second touch
  // inside it (research/product/2026-09-16-meta-window-close-what-shipped-
  // products-do.md §5.1). delayDays stays for anything still reading it and
  // is kept in step (floor(delayHours / 24)) on every write.
  delayHours  Int?
  action      SequenceAction
  stageTo     PipelineStage? // required (validated in sequences.ts) when action is CHANGE_STAGE
  messageHint String? // optional steer for the AI draft when action is EMAIL

  @@unique([sequenceId, order])
}

// Per-source routing — what happens automatically the moment a NEW lead is
// created from a given source (Lead.source, e.g. "Gmail", "Gmail (spam)",
// "SMS", "Phone call", "Webhook", "Manual entry", "CSV import", "Instagram",
// "Website form"). Checked once, right after creation, by
// src/lib/sourceRouting.ts — never on re-sync of an existing lead. A rule
// with sequenceId set enrolls the lead into that workflow immediately
// (mutually exclusive with automationTier per Lead's own rule, so setting
// both here is meaningless — the UI only ever offers one or the other);
// a rule with only automationTierDefault set just changes what silence-based
// automation tier the lead starts on, same as picking it by hand on the
// lead's own page. Both null is a real, valid state ("do nothing special")
// so a rule can exist just to be edited later.
//
// routeToPool (see research/market/2026-09-05-competitor-feature-gaps.md
// #1.1, "Ponds") is a third, equally-exclusive option: instead of the
// normal least-loaded auto-assignment, a lead from this source is
// unassigned right after creation so it sits in a shared pool until
// someone on the team claims it — for a source where "whoever's
// technically least busy" isn't who should actually work it.
model SourceRule {
  id                    String          @id @default(cuid())
  business              Business        @relation(fields: [businessId], references: [id])
  businessId            String
  source                String
  sequence              Sequence?       @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  sequenceId            String?
  automationTierDefault AutomationTier?
  routeToPool           Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([businessId, source])
}

// One row per attempt at a rate-limited, authenticated action (Gmail sync,
// spam scan, AI draft regeneration) — see tooManyRecentActions() in
// src/lib/rateLimit.ts. Exists because OpenAI/Gmail API cost for these
// comes out of one shared platform key, not billed per-business, so a
// single compromised or careless signed-in account could otherwise run up
// a real bill with nothing to stop it beyond the billing gate itself.
// Deliberately not cleaned up automatically yet — rows are small and this
// is new; worth revisiting if the table's growth ever actually matters.
model RateLimitHit {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  action     String
  createdAt  DateTime @default(now())

  @@index([businessId, action, createdAt])
}

// A saved, named lead-list filter ("Smart View" in Close's terms — see
// research/market/2026-09-05-competitor-feature-gaps.md #2.1) — persists
// a custom combination of criteria (src/lib/savedFilters.ts's Criteria
// shape) that the hardcoded quick-filter chips in LeadsPageClient.tsx
// can't express, e.g. "Instagram leads over $2k, no contact in 10 days."
// `shared: false` means only createdById sees it; `shared: true` puts it
// in front of the whole business, same as Close's private-vs-team choice.
// An inbox thread the AI prospect classifier decided was NOT a lead
// (personal mail, a recruiter, a vendor pitch, ...). Kept on purpose:
// until this existed the verdict was thrown away, so a real customer
// email the classifier got wrong simply vanished with no trace — the one
// failure mode "no lead goes cold" can least afford. Settings lists these
// with the classifier's own reason and a one-click "this was a lead"
// override (importGmailThread in src/lib/integrations/gmail.ts). Also
// what stops the automatic sync re-classifying the same rejected thread
// every ten minutes: a thread stays skipped until it gets a new message.
model FilteredEmail {
  id            String   @id @default(cuid())
  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  threadId      String // Gmail thread id, or Outlook (Graph) conversationId
  // Which mailbox this verdict came from — gmail | outlook. Needed so the
  // "restore" action (src/app/api/integrations/gmail/filtered/[id]/restore)
  // knows which provider's importer to call; defaults to "gmail" since
  // every row before Outlook existed was one.
  provider      String   @default("gmail")
  senderName    String
  senderEmail   String
  subject       String?
  reason        String // the classifier's one-line explanation, verbatim
  lastMessageAt DateTime // newest message seen when this verdict was made
  createdAt     DateTime @default(now())

  @@unique([businessId, threadId])
  @@index([businessId, createdAt])
}

model SavedFilter {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  name        String
  shared      Boolean  @default(false)
  // { source?, stage?, priority?, minDealValue?, minDaysSinceContact? } —
  // deliberately loose (no relation, no per-key column) since this is a
  // client-evaluated predicate, not something queried in SQL.
  criteria    Json
  createdAt   DateTime @default(now())

  // getSavedFilters()'s "shared ones + my own private ones" read.
  @@index([businessId, shared])
}

// A pending invitation to join a business's team, by email — not yet a
// User row (that only gets created the moment they actually sign in with
// Google; see the signIn callback in src/lib/auth.ts, which checks for a
// matching Invite before deciding whether a new email gets its own fresh
// Business or joins this one at `role`). Consumed (deleted) the moment
// that sign-in happens.
model Invite {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  email      String
  role       TeamRole @default(SALES)
  createdAt  DateTime @default(now())

  @@unique([businessId, email])
  @@index([businessId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  // Which lead this is about, so the bell dropdown can link straight to
  // it — deliberately not a foreign-key relation to Lead: a notification
  // should stay legible (and its dedup lookup still work) even after the
  // lead it refers to is deleted, rather than being cascade-deleted or
  // blocking the delete. leadId just goes stale in that case; the UI
  // guards against a dead link.
  leadId    String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([leadId])
}

model Integration {
  id                String    @id @default(cuid())
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  provider          String // gmail | google_calendar | outlook | instagram | ...
  status            String    @default("disconnected") // connected | disconnected | error
  accessToken       String?
  refreshToken      String?
  connectedAt       DateTime?
  // When the automatic inbox sync (src/lib/gmailSync.ts, run every few
  // minutes by /api/cron/gmail-sync) last completed for this connection —
  // the next run only asks Gmail for threads newer than this, so a
  // thread is fetched + AI-classified once when it's new, not 30 threads
  // re-classified on every tick.
  lastSyncedAt      DateTime?
  // When the last DEEP pass ran (the full 90-day / 100-thread pull the
  // manual "Sync now" also does). The cron does one automatically once a
  // day on top of the every-ten-minutes incremental tick, so an owner
  // never has to press a button — and a classifier improvement re-judges
  // the whole inbox on its own within a day instead of only new mail.
  deepSyncedAt      DateTime?
  // The last automatic sync failure for this connection (timestamp +
  // message), cleared by the next successful run — so a sync that keeps
  // dying shows up on the row, not only in a serverless log.
  lastSyncError     String?
  // The Gmail address actually connected (can differ from the login
  // email) — what Google's push notifications identify the mailbox by.
  accountEmail      String?
  // Gmail push (src/lib/integrations/gmail.ts ensureGmailWatch): Google
  // publishes a Pub/Sub message the moment the inbox changes, and
  // /api/integrations/gmail/push runs an incremental sync within seconds
  // instead of waiting for the ten-minute tick. A watch lasts 7 days;
  // the cron renews it. pushSyncStartedAt is the short lock that keeps a
  // burst of notifications from starting overlapping syncs.
  watchExpiration   DateTime?
  watchHistoryId    String?
  pushSyncStartedAt DateTime?
  // Outlook only (src/lib/integrations/outlook.ts): unlike googleapis'
  // client, Microsoft Graph doesn't refresh access tokens for us — this is
  // when the current one actually expires, so a call can refresh just
  // ahead of that instead of on every request or only after a 401.
  tokenExpiresAt    DateTime?
  // Outlook only: Graph's delta-query cursor (the last page's
  // @odata.deltaLink) — persisted so the next sync asks Graph for
  // "what changed since here" instead of re-pulling the whole inbox.
  // Null means "no cursor yet," which is also what a fresh connection
  // and a delta gone stale (Graph returns 410 Gone after ~a few weeks of
  // inactivity) both look like — either way the next sync just does one
  // full pass and gets a fresh cursor back.
  deltaLink         String?

  @@unique([userId, provider])
}

model Automation {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  name         String
  triggerDays  Int // e.g. "after 5 days of no response"
  // Hour-granularity window for actions where a day is too coarse — the
  // "unanswered_reply" action (a lead wrote, nobody answered for N hours).
  triggerHours Int?
  action       String // auto_send | instant_ack | unanswered_reply | create_reminder | ai_email_suggestion
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([businessId])
}

// Who did what, when — the record an owner (or an auditor) can read back.
// Written by src/lib/audit.ts from every sensitive action: sends, deletes,
// imports, integration connect/disconnect, settings and team changes,
// billing. Append-only by convention (no route updates or deletes rows).
// `meta` never carries credentials or message bodies, only identifiers
// and counts. Not a relation to Business/User on purpose: an audit row
// must outlive the thing it describes.
// A business's connection to an outside CRM it already runs (Follow Up
// Boss, HubSpot) — for the businesses in the "half already have a CRM"
// half of the market (research/market/2026-09-07-why-followup-evidence-for-and-against.md):
// FollowUp works ALONGSIDE it rather than asking them to leave it. One per
// business (most run exactly one CRM); apiKey is encrypted at rest
// (src/lib/db.ts ENCRYPTED_FIELDS). Sync state mirrors Integration's
// lastSyncedAt/lastSyncError pattern.
model CrmConnection {
  id            String    @id @default(cuid())
  business      Business  @relation(fields: [businessId], references: [id])
  businessId    String    @unique
  provider      String // followupboss | hubspot
  apiKey        String? // FUB: the account API key (Basic auth). HubSpot: a private app access token.
  accountLabel  String? // display only — e.g. the HubSpot portal's own name, if the API returns one
  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())

  // Where a page-budget-truncated sync run left off (see MAX_PAGES_PER_RUN
  // in src/lib/crmSync.ts), so the NEXT run resumes from here instead of
  // restarting at page 1 — without this, an account with more contacts
  // than fit in one run's page budget could never finish backfilling, no
  // matter how many cron ticks passed (research/audit/
  // 2026-09-08-newer-surface-audit.md finding #2). Set alongside
  // lastSyncedAt in the same update: non-null only while a backfill is
  // still in progress, cleared back to null the moment a run completes an
  // untruncated pass (at which point lastSyncedAt itself advances).
  // Provider-specific format (an offset string for Follow Up Boss, an
  // opaque `after` token for HubSpot) — never parsed here, only round-tripped
  // through CrmClient.fetchPage's own cursor parameter.
  syncCursor String?
}

model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([targetId])
}

// Stripe does not guarantee webhook delivery is exactly-once or in order
// (research/market/2026-09-11-stripe-tier-billing-implementation.md §5) — a
// retried or duplicate delivery of the same event.id must not re-apply its
// side effects. One row per successfully-processed event id; the webhook
// handler inserts before processing and, on a unique-constraint collision,
// returns 200 immediately without redoing the work. Rows are never read
// back for anything other than this existence check, so no other indexes
// or fields are needed. Not pruned yet — see the handler for why that's
// deferred rather than a bug.
model ProcessedWebhookEvent {
  eventId     String   @id
  processedAt DateTime @default(now())
}

// The durable landing pad for every inbound lead-bearing payload, written
// BEFORE any of the work it implies (find-or-create the lead, store the
// message, acknowledge, score). Deliberately NOT the same table as
// ProcessedWebhookEvent above, which is Stripe's exactly-once marker: that
// one is keyed on a provider event id, carries no payload, and is DELETED
// again when processing fails (see the rollback in
// src/app/api/billing/webhook/route.ts) — the precise opposite of what is
// needed here, where a failed row must survive so it can be replayed.
// Merging the two would also merge two very different retention lifetimes
// and force Stripe rows to carry columns that mean nothing to them.
//
// Why this exists at all: Twilio and Meta both stop retrying the moment
// they get a 2xx, and these routes must answer 2xx (TwiML / `{success}`)
// or the providers retry in ways that cause their own problems. So the
// provider's copy of the message is gone the instant we answer. If the
// processing that follows throws — an OpenAI timeout, a cold start, a
// provider hiccup, a bug — there has to be a row on disk that proves the
// message arrived and holds enough to redo the work. That is this table.
//
// `payload` is the raw provider body, stored only AFTER signature
// validation has passed (see each route) — an unverified payload is never
// written here, so nothing in this table is attacker-controlled noise.
//
// De-duplication is NOT this table's job. Replaying a row is safe because
// the downstream writes are already idempotent on Message.externalId
// (createInboundMessageIfNew in src/lib/instagram.ts) and on Lead's
// businessId_email / businessId_phone uniques — that existing guarantee is
// what makes replay non-destructive, and it must stay intact.
model InboundWebhookEvent {
  id String @id @default(cuid())

  // Null only when the payload cannot be attributed to one business at the
  // point it is persisted — a Meta envelope is app-wide and can carry
  // entries for several connected accounts at once, so attribution happens
  // per-entry during processing, not here. Intentionally not a relation:
  // a raw-capture log must never be the thing that blocks a business from
  // being deleted, and deleteBusinessData() clears these explicitly.
  businessId String?

  // twilio | meta | http — who sent it.
  provider String
  // sms | whatsapp | instagram_or_messenger | webhook_lead | embed_form —
  // which capture path replay should hand it back to. A string, not an
  // enum, so a new channel needs no type migration.
  channel String

  // The provider's own id for this delivery when it has one (a Twilio
  // MessageSid). Meta envelopes carry per-event ids inside the payload
  // instead, so this stays null for them. Informational only — de-dup is
  // enforced downstream on Message.externalId, not here.
  externalId String?

  payload    Json
  receivedAt DateTime @default(now())

  // pending | processed | failed. A row that is still `pending` long after
  // receivedAt means the process died mid-request — replayable exactly
  // like a `failed` one.
  status      String    @default("pending")
  processedAt DateTime?
  attempts    Int       @default(0)
  // The failure that stopped processing, truncated. Recorded rather than
  // swallowed: several of these routes used to catch-and-continue, which
  // left no trace anywhere that a lead had been dropped.
  error String?

  // The replay query: everything not yet processed, oldest first.
  @@index([status, receivedAt])
  @@index([businessId, receivedAt])
}

model AIInsight {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  summary   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Passive, optional feedback about FollowUp itself, from the people using
// it — not customer feedback collected from leads. No `read`/`resolved`
// state to manage here on purpose: this is a message in a bottle, not a
// support ticket. userId/userName are a point-in-time snapshot (not a
// relation) so a submission stays legible even if that user is later
// removed from the team — see src/lib/team.ts's removeMember(), which
// only detaches a User from a Business, this preserves who actually said
// it regardless. See src/app/api/feedback/route.ts and the quiet form in
// Settings — never a popup, never forced; nothing anywhere prompts for
// this unprompted.
// The beta tester list. One row per email, added by the founder from
// /admin (POST /api/access-request, platform admin only) — there is no
// public way to ask (his decision, 2026-09-19). `status`: approved |
// declined. An approved email may sign in (src/lib/auth.ts) — the invite,
// without editing ALLOWED_EMAILS and paying for a redeploy each time.
// Sign-up stays invite-only (PRODUCT_DIRECTION, 2026-09-18).
model AccessRequest {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  business  String?
  channels  String    @default("") // comma-joined: email,instagram,whatsapp,text,website,other
  note      String?
  status    String    @default("approved")
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

model ProductFeedback {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  userId     String
  userName   String
  message    String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────────────────
// The AI office — internal, not a tenant feature.
//
// `.claude/agents/` already describes five lanes (manager, product/UX,
// frontend/3D, backend/AI, QA/security), but those only exist while
// someone has a Claude Code session open. These three models are the part
// that survives the session: a roster, a queue of work, and a record of
// every shift an agent actually worked — what it cost, what it produced,
// and whether it succeeded.
//
// Deliberately NOT scoped to a Business. This is the founder's own office
// for building FollowUp, and it lives behind the same PLATFORM_ADMIN_EMAILS
// gate as /admin (src/lib/platformAdmin.ts) — never shown to a customer.
// If the office is ever turned outward as a product, every model here gains
// a businessId — don't retrofit tenancy by reusing these rows.
// ─────────────────────────────────────────────────────────────────────────

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  // Refused before it started — over its daily spend ceiling, or the role
  // is disabled. Kept as a row rather than dropped silently so the floor
  // can show "it tried and was stopped" instead of nothing at all.
  BLOCKED
}

enum AgentTaskStatus {
  OPEN
  DONE
  CANCELLED
}

// One desk. Seeded from src/lib/office/roles.ts, which mirrors the job
// descriptions in `.claude/agents/` — that stays the source of truth for
// what a lane *is*; this row is the source of truth for whether it's on
// shift and what it may spend.
model AgentRole {
  id                  String      @id @default(cuid())
  key                 String      @unique // matches the filename in .claude/agents/, e.g. "product-ux-agent"
  title               String
  brief               String
  wakesOn             String // human-readable trigger, shown on the floor
  gate                String // what it may do without a human press
  // A lane with no runner implementation yet is still seeded so the floor
  // shows the whole org chart, not just the parts that are live.
  live                Boolean     @default(false)
  enabled             Boolean     @default(true)
  // Hard daily ceiling in USD, enforced in runner.ts before a shift opens.
  // Low on purpose: a desk that needs more should earn it.
  dailyCostCeilingUsd Float       @default(1.0)
  createdAt           DateTime    @default(now())
  runs                AgentRun[]
  tasks               AgentTask[]
}

// Work you (or, later, the manager lane) put on a desk. This first pass
// creates them but only ever assigns them by hand.
model AgentTask {
  id        String          @id @default(cuid())
  role      AgentRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String
  title     String
  detail    String          @default("")
  status    AgentTaskStatus @default(OPEN)
  createdBy String // email of whoever opened it
  createdAt DateTime        @default(now())
  closedAt  DateTime?
  runs      AgentRun[]

  @@index([roleId, status])
}

// One shift. The whole point of the office: work that happened while you
// weren't watching, with the receipt attached.
model AgentRun {
  id           String         @id @default(cuid())
  role         AgentRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  task         AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId       String?
  status       AgentRunStatus @default(RUNNING)
  // What woke it: "cron", "manual:you@example.com".
  trigger      String
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  // One line for the floor; `output` is the full thing it wrote.
  summary      String         @default("")
  output       String         @default("") @db.Text
  error        String?
  model        String         @default("")
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  // Priced at call time from the rates in runner.ts — stored rather than
  // recomputed so a later price change doesn't rewrite history.
  costUsd      Float          @default(0)

  @@index([roleId, startedAt])
  @@index([startedAt])
}
